# ---------------------------------------------------------------------
# Sawari settings — TEMPLATE. This file has no secrets and is shared.
# Copy it to .env.local and fill in values there. .env.local stays on
# your computer only (it is ignored by git).
# ---------------------------------------------------------------------

# Database (Supabase). For the local database, run `npm run db:start`
# and copy the API URL and keys it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public (anon / publishable) key: safe to reach the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (secret) key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI (Gemini). Keep LLM_ENABLED=false until Week 5. Use a paid-tier key
# for any real user text (free-tier content may be used by Google).
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Map file (added later, plan milestone M11).
NEXT_PUBLIC_PMTILES_URL=/tiles/ranchi.pmtiles

# Comma-separated emails that get the reviewer role (later milestone).
REVIEWER_EMAILS=
